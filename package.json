{
  "name": "dsh-serial-keil",
  "version": "0.1.0",
  "private": true,
  "description": "Serial assistant and Keil build/flash loop for DeepSeek Harness: ASCII/HEX log, send box, and watch → build → download → read-back with a guard on the project the Keil IDE has open.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fanxx-lab/dsh-serial-keil.git"
  },
  "homepage": "https://github.com/fanxx-lab/dsh-serial-keil#readme",
  "bugs": {
    "url": "https://github.com/fanxx-lab/dsh-serial-keil/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "keil",
    "serial-port",
    "embedded"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "loop.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
