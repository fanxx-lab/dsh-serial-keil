{
  "name": "@local/dsh-serial-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Read serial-port output on the host and mirror it into the right sidebar with a port picker.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "loop.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
